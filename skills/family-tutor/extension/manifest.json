{
  "manifest_version": 3,
  "name": "Family Tutor ChatGPT Bridge",
  "version": "2.6.0",
  "description": "Routes Family Tutor turns to assigned ChatGPT Projects.",
  "key": "",
  "permissions": [
    "identity",
    "storage",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://family-tutor.qili2.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/disconnected-16.png",
      "32": "icons/disconnected-32.png",
      "48": "icons/disconnected-48.png",
      "128": "icons/disconnected-128.png"
    }
  },
  "icons": {
    "16": "icons/disconnected-16.png",
    "32": "icons/disconnected-32.png",
    "48": "icons/disconnected-48.png",
    "128": "icons/disconnected-128.png"
  }
}
